# Environment Mode
NODE_ENV=development

# Server Port
PORT=5000
FRONTEND_PORT=5173

# Database Connection (PostgreSQL)
# Local development hoặc qua Docker Compose:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/club_portal_db?schema=public"

# JWT Secret Keys
JWT_SECRET="super-secret-jwt-key-for-university-club-portal-2026"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Super Admin Initial Credentials (Dùng cho script seed)
INITIAL_ADMIN_EMAIL="admin@bafu.edu.vn"
INITIAL_ADMIN_PASSWORD="AdminPassword@2026"
INITIAL_ADMIN_NAME="Quản Trị Viên Đại Học BAFU"

# ==============================================================================
# CẤU HÌNH GỬI EMAIL SMTP (GMAIL HOẶC GOOGLE WORKSPACE BAFU)
# Khi để trống, hệ thống sẽ tự động dùng chế độ MOCK (log mã OTP ra màn hình console / terminal)
# Khi muốn gửi email thật đến hòm thư người dùng:
# 1. Bật xác thực 2 bước (2FA) trong tài khoản Google.
# 2. Truy cập https://myaccount.google.com/apppasswords để tạo "Mật khẩu ứng dụng" 16 ký tự.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cổng Thông Tin CLB Sinh Viên BAFU" <no-reply@bafu.edu.vn>
