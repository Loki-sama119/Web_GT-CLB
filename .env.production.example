# ==============================================================================
# UNIVERSITY CLUB PORTAL — BAFU PRODUCTION ENVIRONMENT TEMPLATE
# HƯỚNG DẪN: Sao chép tệp này thành .env.production trên VPS/Server và điền thông tin thật.
# TUYỆT ĐỐI KHÔNG commit tệp chứa mật khẩu/secret thật lên Git.
# ==============================================================================

# 1. Cơ sở dữ liệu PostgreSQL nội bộ (Private Network)
POSTGRES_USER=bafu_db_admin
POSTGRES_PASSWORD=generate-a-strong-random-password-here-min-32-chars
POSTGRES_DB=club_portal_prod_db

# 2. Bảo mật JWT & Session
# Sinh khóa ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-a-very-strong-jwt-secret-key-at-least-64-characters
JWT_EXPIRES_IN=7d

# 3. Tên miền & Mạng
NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://clb.bafu.edu.vn
AUTH_RATE_LIMIT_MAX=100

# 4. Cấu hình gửi Email SMTP (Google Workspace / Microsoft 365 BAFU)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=clb-thongbao@bafu.edu.vn
SMTP_PASS=app-specific-password-from-google-workspace
SMTP_FROM="Cổng CLB BAFU" <no-reply@bafu.edu.vn>
